# Copiar a .env para probar localmente con `netlify dev`.
# En producción, estas mismas claves se cargan como variables de entorno en Netlify.

SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (NO la anon key) — Settings > API en Supabase
ADMIN_KEY=elegí-una-clave-larga-y-rara
WHATSAPP_NUMBER=5493585730000  # número de WhatsApp de la distribuidora (54 + 9 + área + línea, sin + ni espacios)
